name: 每日A股持仓复盘

on:
  schedule:
    - cron: '30 7 * * 1-5'
  workflow_dispatch:

permissions:
  contents: write

concurrency:
  group: daily-review
  cancel-in-progress: false

jobs:
  review:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      - name: 抓取行情
        run: python fetch_market.py data

      - name: 判定交易日
        id: cal
        run: |
          DATE=$(python -c "import json;print(json.load(open('data/market.json'))['trade_date'])")
          TODAY=$(TZ=Asia/Shanghai date +%F)
          [ "$DATE" = "$TODAY" ] && echo "is_trading=true" >> $GITHUB_OUTPUT || echo "is_trading=false" >> $GITHUB_OUTPUT
          echo "date=$DATE" >> $GITHUB_OUTPUT
          echo "行情日期=$DATE  今天=$TODAY"

      - name: 生成复盘
        if: steps.cal.outputs.is_trading == 'true'
        run: |
          mkdir -p site
          python generate_report.py data/market.json "site/${{ steps.cal.outputs.date }}.html"
          cp "site/${{ steps.cal.outputs.date }}.html" site/latest.html
          python update_index.py site
          python -c "import json;d=json.load(open('data/market.json'));print('## 复盘 %s\n\n**加仓触发 %d/%d**'%(d['trade_date'],d['triggered_count'],d['trigger_total']))" >> $GITHUB_STEP_SUMMARY

      - name: 发布到 gh-pages
        if: steps.cal.outputs.is_trading == 'true'
        env:
          DATE: ${{ steps.cal.outputs.date }}
        run: |
          git config user.name  "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          cd site
          git init -q && git checkout -q -B gh-pages
          git add -A && git commit -q -m "review $DATE"
          git push -q -f "https://x-access-token:${{ secrets.GITHUB_TOKEN }}@github.com/${{ github.repository }}.git" gh-pages
          echo "published $DATE"

      - name: 存档原始数据
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: market-data-${{ steps.cal.outputs.date }}
          path: data/market.json
          retention-days: 90
